t = int(input().strip())
for _ in range(t):
    n,c = map(int, input().split())
    a = list(map(int, input().split()))
    s = input().strip()
    sum0 = sum(a[i] for i in range(n) if s[i]=='0')
    sum1 = sum(a[i] for i in range(n) if s[i]=='1')
    if sum0 < c:
        print(sum0)
    else:
        print(max(sum0, sum0 - c + sum1))
