import sys
def solve():
    input = sys.stdin.read
    data = input().split()
    if not data:
        return
    t = int(data[0])
    idx = 1
    out = []
    for _ in range(t):
        n = int(data[idx])
        s = data[idx+1]
        idx += 2
        opens = 0
        current_char = ''
        current_count = 0
        for char in s:
            if char == current_char:
                current_count += 1
            else:
                current_char = char
                current_count = 1
            if current_count == 3:
                opens += 1
                current_count = 0 
        out.append(str(opens))
    print('\n'.join(out))
if __name__ == '__main__':
    solve()
