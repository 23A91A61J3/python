import sys

input = sys.stdin.read
data = input().split()

idx = 0
T = int(data[idx])
idx += 1

for _ in range(T):
    N = int(data[idx])
    idx += 1
    A = [int(data[idx + i]) for i in range(N)]
    idx += N

    total_sum = sum(A)
    min_pair_sum = min(A[i] + A[i + 1] for i in range(N - 1))

    print(total_sum - (min_pair_sum // 2))
