n, k = map(int, input().split())
arr = list(map(int, input().split()))

low = 0
high = n - 1
found = False

while low <= high:
    mid = (low + high) // 2
    print(low, high, mid)

    if arr[mid] == k:
        found = True
        break
    elif arr[mid] < k:
        low = mid + 1
    else:
        high = mid - 1

if found:
    print("True")
else:
    print("False")
