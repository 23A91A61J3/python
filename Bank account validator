import sys
def solve():
    input_data = sys.stdin.read().splitlines()
    if not input_data:
        return
    T = int(input_data[0])
    for i in range(1, T + 1):
        account_str = input_data[i].strip()
        digit_sum = sum(int(digit) for digit in account_str)
        if digit_sum % 10 == 0:
            print("Valid")
        else:
            print("Invalid")
if __name__ == '__main__':
    solve()
