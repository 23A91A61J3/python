import sys
def solve():
    input = sys.stdin.read
    data = input().split()
    if not data:
        return
    t = int(data[0])
    idx = 1
    out = []
    for _ in range(t):
        n = int(data[idx])
        m = int(data[idx+1])
        s = data[idx+2]
        l = data[idx+3]
        idx += 4
        left_hand_keys = set(l)
        max_streak = 0
        current_streak = 0
        prev_hand = None
        for char in s:
            current_hand = 'L' if char in left_hand_keys else 'R'            
            if current_hand == prev_hand:
                current_streak += 1
            else:
                current_streak = 1
                prev_hand = current_hand
            if current_streak > max_streak:
                max_streak = current_streak
        out.append(str(max_streak))
    print('\n'.join(out))
if __name__ == '__main__':
    solve()
