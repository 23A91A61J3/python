import sys
input = sys.stdin.read
data = input().split()

t = int(data[0])
idx = 1
for _ in range(t):
    n = int(data[idx])
    idx += 1
    a = list(map(int, data[idx : idx + n]))
    idx += n
    b = list(map(int, data[idx : idx + n]))
    idx += n
    
    count = 0
    for alice_val, bob_val in zip(a, b):
        if bob_val <= 2 * alice_val and alice_val <= 2 * bob_val:
            count += 1
    
    print(count)
