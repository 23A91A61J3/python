import sys
def solve():
    input = sys.stdin.read
    data = input().split()
    if not data:
        return
    t = int(data[0])
    idx = 1
    out = []
    for _ in range(t):
        n = int(data[idx])
        idx += 1
        a = [int(x) for x in data[idx : idx + n]]
        idx += n
        good_count = 0
        for i in range(n):
            start_idx = max(0, i - 5)
            preceding_elements = a[start_idx:i]
            if not preceding_elements:
                good_count += 1
            else:
                if a[i] < min(preceding_elements):
                    good_count += 1
        out.append(str(good_count))
    print('\n'.join(out))
if __name__ == '__main__':
    solve()
